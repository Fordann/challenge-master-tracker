# Example environment variables for lol-tracker

# Database (MySQL) - used by Prisma
DATABASE_URL="mysql://loltracker:password@localhost:3306/loltracker"

# Riot API
RIOT_API_KEY="your_riot_api_key_here"

# n8n webhook settings
N8N_WEBHOOK_URL="http://localhost:5678/"
N8N_WEBHOOK_SECRET="your_n8n_webhook_secret"

# remove.bg API
REMOVEBG_API_KEY="your_removebg_api_key"

# Admin password for basic admin features
ADMIN_PASSWORD="changeme"

# Challenge period (ISO 8601)
CHALLENGE_START="2026-03-01T00:00:00Z"
CHALLENGE_DEADLINE="2026-03-31T23:59:59Z"

# Cron interval in minutes (default 5)
CRON_INTERVAL_MINUTES=5

# Optional webhook URL used by some services
WEBHOOK_URL="http://localhost:5678/"

# Optional local MariaDB credentials (used by docker-compose mariadb service)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=loltracker
MYSQL_USER=loltracker
MYSQL_PASSWORD=password
